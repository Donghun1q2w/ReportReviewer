{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cert-review-skill/extraction-schema.json",
  "title": "Cert Extraction Schema",
  "version": "2.0",
  "description": "Schema for the unified <cert_stem>_extracted.json produced by combining Claude Vision OCR (body) with Python-extracted PDF annotations and zip attachments. Python OCR libraries are forbidden.",
  "type": "object",
  "required": ["schema_version", "case_id", "cert_file", "cert_sha256", "channels", "page_extraction"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "case_id": {"type": "string"},
    "cert_file": {"type": "string"},
    "cert_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extracted_at": {"type": "string", "format": "date-time"},
    "channels": {
      "type": "object",
      "required": ["body", "annotations"],
      "properties": {
        "body": {
          "type": "object",
          "required": ["engine", "pages"],
          "properties": {
            "engine": {"const": "claude-vision"},
            "pages": {"type": "array", "items": {"type": "integer"}}
          }
        },
        "annotations": {
          "type": "object",
          "required": ["engine", "items"],
          "properties": {
            "engine": {"const": "pypdf"},
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["page", "subtype", "text"],
                "properties": {
                  "page": {"type": "integer"},
                  "author": {"type": ["string", "null"]},
                  "subtype": {"type": "string"},
                  "text": {"type": "string"},
                  "rect": {"type": ["array", "null"]}
                }
              }
            }
          }
        },
        "zip_attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["zip_file", "extracted_files"],
            "properties": {
              "zip_file": {"type": "string"},
              "extracted_files": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "page_extraction": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "header"],
        "properties": {
          "page": {"type": "integer"},
          "header": {
            "type": "object",
            "properties": {
              "po_number": {"type": ["string", "null"]},
              "cert_no": {"type": ["string", "null"]},
              "vendor": {"type": ["string", "null"]},
              "spec": {"type": ["string", "null"]},
              "grade": {"type": ["string", "null"]},
              "heat_no": {"type": ["string", "null"]},
              "size_od_wt": {"type": ["string", "null"]},
              "quantity": {"type": ["integer", "null"]},
              "length_mm": {"type": ["number", "null"]}
            }
          },
          "chemistry": {
            "type": ["object", "null"],
            "properties": {
              "analysis_type": {"enum": ["Heat", "Product", "Heat+Product", null]},
              "elements": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["value"],
                  "properties": {
                    "value": {"type": ["number", "null"]},
                    "unit": {"type": "string"}
                  }
                }
              }
            }
          },
          "mechanical": {
            "type": ["object", "null"],
            "properties": {
              "TS_MPa": {"type": ["number", "null"]},
              "YS_MPa": {"type": ["number", "null"]},
              "EL_pct": {"type": ["number", "null"]},
              "RA_pct": {"type": ["number", "null"]},
              "hardness": {
                "type": ["object", "null"],
                "properties": {
                  "value": {"type": ["number", "null"]},
                  "unit": {"enum": ["HBW", "HRC", "HRB", "HV", null]}
                }
              },
              "impact": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "temp_C": {"type": ["number", "null"]},
                    "value_J": {"type": ["number", "null"]},
                    "direction": {"type": ["string", "null"]}
                  }
                }
              }
            }
          },
          "heat_treatment": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stage": {"type": "string"},
                "temp_C": {"type": ["number", "null"]},
                "hold_min": {"type": ["number", "null"]},
                "cooling": {"type": ["string", "null"]}
              }
            }
          },
          "nde": {
            "type": ["object", "null"],
            "additionalProperties": {
              "type": "object",
              "properties": {
                "performed": {"type": "boolean"},
                "notch": {"type": ["string", "null"]},
                "depth_mm": {"type": ["number", "null"]},
                "result": {"type": ["string", "null"]}
              }
            }
          },
          "remarks": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["channel", "source_file", "anchor", "snippet", "sha256"],
      "properties": {
        "channel": {"enum": ["body", "annotations", "mps", "ref_code"]},
        "source_file": {"type": "string"},
        "anchor": {"type": "string"},
        "snippet": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "category", "severity", "issue_summary", "evidence"],
      "properties": {
        "finding_id": {"type": "string"},
        "category": {"enum": ["Chemistry", "Mechanical", "HeatTreatment", "NDE", "Microstructure", "Identification", "DocumentError", "Other"]},
        "severity": {"enum": ["Reject", "ActionRequired", "Question", "Minor"]},
        "material_grade": {"type": ["string", "null"]},
        "heat_no": {"type": ["string", "null"]},
        "page_ref": {"type": ["string", "null"]},
        "issue_summary": {"type": "string"},
        "details": {"type": "string"},
        "required_action": {"type": "string"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    }
  }
}
